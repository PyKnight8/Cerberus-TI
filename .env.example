# Obtain keys at https://auth.abuse.ch/ (one key may work for both services).
URLHAUS_AUTH_KEY=
THREATFOX_AUTH_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CERBERUS_SECRET_KEY=
# Optional overrides; YAML remains the source for ordinary configuration.
# CERBERUS_CONFIG=config.yaml
# CERBERUS_DATABASE_URL=sqlite:///./data/cerberus.db
# CERBERUS_UPDATE_INTERVAL_MINUTES=60
# CERBERUS_SCHEDULER_ENABLED=true
# CERBERUS_UPDATE_ON_START=true
# CERBERUS_LOG_LEVEL=INFO
# Docker: use your homelab interface IP to make the list reachable by Pi-hole.
# CERBERUS_BIND_IP=192.168.1.10

# Optional automated subscribed-pulse intelligence (enable in Feeds)
OTX_API_KEY=
# Optional administrator-triggered investigation only
VIRUSTOTAL_API_KEY=
